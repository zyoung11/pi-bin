{
  "name": "pi-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/session-backends/*",
    "packages/coding-agent/examples/extensions/with-deps",
    "packages/coding-agent/examples/extensions/custom-provider-anthropic",
    "packages/coding-agent/examples/extensions/custom-provider-gitlab-duo",
    "packages/coding-agent/examples/extensions/sandbox",
    "packages/coding-agent/examples/extensions/gondolin"
  ],
  "scripts": {
    "check": "biome check --write --error-on-warnings . && tsgo --noEmit",
    "build:native": "bash scripts/build-native.sh",
    "generate:models": "npm --prefix packages/ai run generate-models && npm --prefix packages/ai run generate-image-models",
    "hydrate:model-data": "npm --prefix packages/ai run hydrate-model-data",
    "check:model-data": "npm --prefix packages/ai run check:model-data",
    "eval": "npm run eval --workspace=@earendil-works/pi-evals --"
  },
  "devDependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.26",
    "@biomejs/biome": "2.3.5",
    "@types/node": "22.19.19",
    "@typescript/native-preview": "7.0.0-dev.20260120.1",
    "esbuild": "0.28.1",
    "husky": "9.1.7",
    "shx": "0.4.0",
    "tsx": "4.22.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "version": "0.2.3",
  "overrides": {
    "protobufjs": "7.6.5",
    "rimraf": "6.1.2",
    "gaxios": {
      "rimraf": "6.1.2"
    }
  }
}